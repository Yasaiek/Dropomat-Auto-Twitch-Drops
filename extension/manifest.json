{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "short_name": "Dropomat",
  "version": "1.2.1",
  "description": "__MSG_extDesc__",
  "default_locale": "en",
  "key": "",
  "minimum_chrome_version": "120",
  "permissions": [
    "storage",
    "alarms",
    "tabs",
    "cookies",
    "notifications",
    "debugger",
    "declarativeNetRequestWithHostAccess"
  ],
  "host_permissions": [
    "https://www.twitch.tv/*",
    "https://gql.twitch.tv/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Dropomat"
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.twitch.tv/*"
      ],
      "js": [
        "inject.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://www.twitch.tv/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    }
  ]
}